:root {
  --primary-color: #f95606;
  --secondary-color: #7a3eb1;
  --accent-color: #ffd43b;
  --blue-color: #0066cc;
  --light-color: #f8f9fa;
  --neutral-color: #e0e0e0;
  --gray-color: #666666;
  --text-color: #333333;

  /* Ajout de nuances */
  --primary-light: #ff7a3a;
  --primary-dark: #c43f04;
  --secondary-light: #9b5ed1;
  --secondary-dark: #5a2a85;
}

.dark {
  --primary-color: #ffd43b; 
  --secondary-color: #7a3eb1;
  --accent-color: #f95606;
  --dark-color: #333333;
  --light-color: #1a1a1a;
  --neutral-color: #444444;
  --gray-color: #aaaaaa;
  --text-color: #f8f9fa;

  --primary-light: #ffe066;
  --primary-dark: #cc9f00;
  --secondary-light: #9b5ed1;
  --secondary-dark: #5a2a85;
}

/* Background utilities */
.bg-primary { background-color: var(--primary-color); }
.bg-primary-light { background-color: var(--primary-light); }
.bg-primary-dark { background-color: var(--primary-dark); }

.bg-secondary { background-color: var(--secondary-color); }
.bg-secondary-light { background-color: var(--secondary-light); }
.bg-secondary-dark { background-color: var(--secondary-dark); }

.bg-accent { background-color: var(--accent-color); }
.bg-blue { background-color: var(--blue-color); }
.bg-light { background-color: var(--light-color); }
.bg-neutral { background-color: var(--neutral-color); }
.bg-gray { background-color: var(--gray-color); }
.bg-dark { background-color: var(--dark-color); }

/* Text utilities */
.text-primary { color: var(--primary-color); }
.text-primary-light { color: var(--primary-light); }
.text-primary-dark { color: var(--primary-dark); }

.text-secondary { color: var(--secondary-color); }
.text-secondary-light { color: var(--secondary-light); }
.text-secondary-dark { color: var(--secondary-dark); }

.text-accent { color: var(--accent-color); }
.text-blue { color: var(--blue-color); }
.text-light { color: var(--light-color); }
.text-neutral { color: var(--neutral-color); }
.text-gray { color: var(--gray-color); }
.text-dark { color: var(--dark-color); }
.text-base { color: var(--text-color); }

/* Border utilities */
.border-primary { border-color: var(--primary-color); }
.border-secondary { border-color: var(--secondary-color); }
.border-accent { border-color: var(--accent-color); }
.border-blue { border-color: var(--blue-color); }
.border-light { border-color: var(--light-color); }
.border-neutral { border-color: var(--neutral-color); }
.border-gray { border-color: var(--gray-color); }
.border-dark { border-color: var(--dark-color); }

/* Hover states */
.hover-primary:hover { background-color: var(--primary-dark); }
.hover-primary-dark:hover { background-color: var(--primary-light); }
.hover-secondary:hover { background-color: var(--secondary-dark); }
.hover-accent:hover { background-color: var(--accent-color); opacity: 0.85; }
.btn-hover:hover {
    background-color: none;
    border-color: var(--primary-color);
    color: var(--primary-color);}
